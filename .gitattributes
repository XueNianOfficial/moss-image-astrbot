# Normalise line endings so the PowerShell scripts keep working on Windows
# while everything else stays LF (CI, Linux, editors).
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.png  binary
